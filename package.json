{
  "name": "dsh-model-failover",
  "version": "0.2.1",
  "description": "Automatically degrade to the next configured model on quota, upstream or transport errors and continue the session.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib/index.js",
    "lib/rules.js",
    "lib/state.js",
    "cordis.patch.yml",
    "config.example.yml",
    "rules.yaml",
    "README.md",
    "lib/client.js"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./rules": "./lib/rules.js",
    "./state": "./lib/state.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "keywords": [
    "dsh-plugin",
    "failover",
    "model",
    "quota"
  ]
}
